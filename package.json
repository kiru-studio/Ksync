{
  "name": "ksync",
  "version": "2.4.2",
  "description": "A Spotify dock with auto-hide and lyrics display",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/patch-electron.js && electron .",
    "patch:electron": "node scripts/patch-electron.js",
    "postinstall": "node scripts/patch-electron.js",
    "dev": "concurrently \"npm run start\" \"npm run watch\"",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:icon": "node scripts/build-icon.js",
    "dist": "npm run build && npm run build:icon && electron-builder",
    "pack": "npm run build && npm run build:icon && electron-builder --dir",
    "release": "npm run build && npm run build:icon && electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiru-studio/Ksync.git"
  },
  "keywords": [
    "spotify",
    "dock",
    "widget",
    "lyrics",
    "music"
  ],
  "author": "kiru studio",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "framer-motion": "^10.16.5",
    "html-webpack-plugin": "^5.5.3",
    "lucide-react": "^0.294.0",
    "playwright": "^1.64.1",
    "png-to-ico": "^2.1.8",
    "rcedit": "^5.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.ksync",
    "productName": "ksync",
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "kiru-studio",
        "repo": "Ksync"
      }
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "scripts/strip-locales.js",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "package.json",
      "dist/**/*",
      "src/**/*",
      "assets/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "smtc-bridge/bin/Release/net10.0-windows10.0.19041.0/win-x64/publish_compressed/smtc-bridge.exe",
        "to": "smtc-bridge.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
